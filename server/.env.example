PORT=4000

# PostgreSQL connection. Either set DATABASE_URL, or the individual PG* vars below.
DATABASE_URL=postgresql://auditor:auditor@localhost:5432/extension_risk_auditor

PGHOST=localhost
PGPORT=5432
PGUSER=auditor
PGPASSWORD=auditor
PGDATABASE=extension_risk_auditor

# Comma-separated list of extension origins allowed to call this API.
# chrome-extension://<your-unpacked-extension-id> once you've loaded it in Chrome.
CORS_ORIGIN=*
